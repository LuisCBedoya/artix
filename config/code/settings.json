{
  "workbench.colorTheme": "poimandres",
  "workbench.activityBar.location": "hidden",
  "workbench.editor.showTabs": "multiple",
  "workbench.statusBar.visible": true,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.iconTheme": "symbols",
  "workbench.tree.enableStickyScroll": false,
  "workbench.tree.renderIndentGuides": "none",
  "workbench.tree.indent": 8,
  "workbench.colorCustomizations": {
    //editor, sidebar, statusbar
    "editor.background": "#070707", // Fondo del editor
    "activityBar.background": "#080808", // Fondo de la barra lateral
    "sideBar.background": "#080808", // Fondo de la barra lateral
    "statusBar.background": "#101010", // Fondo de la barra de estado
    //tabs
    "tab.activeBackground": "#070707", // Fondo de la pestaña activa
    "tab.inactiveBackground": "#070707", // Fondo de la pestaña inactiva
    "tab.hoverBackground": "#070707", // Fondo cuando pasas el mouse sobre la pestaña
    "tab.activeBorder": "#070707", // Color del borde de la pestaña activa
    "tab.inactiveBorder": "#070707", // Color del borde de la pestaña inactiva
    "tab.unfocusedActiveBackground": "#101010", // Fondo de la pestaña activa cuando no está enfocado
    "tab.unfocusedInactiveBackground": "#101010", // Fondo de la pestaña activa cuando no está enfocado
    "editorGroupHeader.tabsBackground": "#070707", //barra que sostine las pestañas
    //terminal
    "terminal.background": "#070707",
    // "terminal.foreground": "#FFFFFF",
    //panel terminal
    "panel.background": "#080808",
    "panel.border": "#101010",
    // hover tooltips
    "editorHoverWidget.background": "#101010",
    "editorHoverWidget.border": "#303030",
    // menu contextual
    "menu.background": "#080808",
    "menu.foreground": "#ffffff",
    "menu.selectionBackground": "#303030",
    //scroll
    "scrollbarSlider.background": "#44444488", // color con transparencia
    "scrollbarSlider.hoverBackground": "#555555aa",
    "scrollbarSlider.activeBackground": "#666666cc",
    //inputs
    "input.background": "#101010",
    "input.foreground": "#ffffff",
    "input.border": "#303030",
    //indent
    "editorIndentGuide.background1": "#444444",
    "editorIndentGuide.activeBackground1": "#888888",
    //sugerencias
    "editorSuggestWidget.background": "#080808", // Fondo del panel de sugerencias
    "editorSuggestWidget.foreground": "#FFFFFF", // Color del texto normal
    "editorSuggestWidget.selectedBackground": "#303030", // Fondo del ítem seleccionado (el que resaltas con ↑↓)
    "editorSuggestWidget.highlightForeground": "#00FFFF", // Color para texto resaltado (las coincidencias con lo que escribiste)
    "editorSuggestWidget.border": "#101010",
    "editorSuggestWidget.focusHighlightForeground": "#FF00FF", // Cuando haces foco y hay coincidencias
    "editorSuggestWidget.selectedForeground": "#FFFFFF", // Texto del ítem seleccionado
    "editorSuggestWidget.selectedIconForeground": "#FFFFFF", // Color de iconos en selección
    //notifications
    "notification.centerHeader.background": "#080808",
    "notification.toast.background": "#101010",
    "notification.foreground": "#ffffff",
    // gutter
    // "editorLineNumber.foreground": "#babeaf",
    // "editorLineNumber.activeForeground": "#5d7781",
    "editor.lineHighlightBackground": "#131313",
    "editorGutter.background": "#070707",
    "editorCursor.background": "#000000",
    //colors git
    "editorGutter.modifiedBackground": "#017bcd",
    "editorGutter.addedBackground": "#54bc5c",
    "editorGutter.deletedBackground": "#ea7676",
    // debug
    "editorGutter.breakpointForeground": "#ff5555", // Color del ícono de advertencia
    "editorGutter.warningBackground": "#e0af68", // Color del ícono de warning
    // "editorGutter.errorBackground": "#f7768e", // color de icono de error
    // tilebar
    "titleBar.activeBackground": "#070707", // Fondo de la barra de título (cuando está enfocada)
    "titleBar.activeForeground": "#ffffff", // Color del texto en la barra de título
    "titleBar.inactiveBackground": "#101010", // Fondo de la barra de título (cuando no está enfocada)
    "titleBar.inactiveForeground": "#FFF", // Color del texto en la barra de título (cuando no está enfocada)
    // panel
    "quickInput.background": "#080808", // Fondo general del panel (la parte donde están las opciones)
    "quickInput.border": "#FFF", // Color del borde del panel
    // "list.activeSelectionBackground": "#005f5f", // Fondo del elemento seleccionado en la lista
    "list.activeSelectionForeground": "#ffffff", // Texto del elemento seleccionado
    // "list.hoverBackground": "#333333"// Fondo del elemento al pasar el mouse
    //bracket
    "editorBracketHighlight.foreground1": "#AAAAAA88",
    "editorBracketHighlight.foreground2": "#AAAAAA88",
    "editorBracketHighlight.foreground3": "#AAAAAA88",
    "editorBracketHighlight.foreground4": "#AAAAAA88",
    "editorBracketHighlight.foreground5": "#AAAAAA88",
    "editorBracketHighlight.foreground6": "#AAAAAA88",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF4444", // rojo todavía más suave
    "editorBracketPairGuide.activeBackground1": "#AAAAAA88",
    "editorBracketPairGuide.activeBackground2": "#AAAAAA88",
    "editorBracketPairGuide.activeBackground3": "#AAAAAA88",
    "editorBracketPairGuide.activeBackground4": "#AAAAAA88",
    "editorBracketPairGuide.activeBackground5": "#AAAAAA88",
    "editorBracketPairGuide.activeBackground6": "#AAAAAA88",
    "editorBracketPairGuide.background1": "#AAAAAA14",
    "editorBracketPairGuide.background2": "#AAAAAA14",
    "editorBracketPairGuide.background3": "#AAAAAA14",
    "editorBracketPairGuide.background4": "#AAAAAA14",
    "editorBracketPairGuide.background5": "#AAAAAA14",
    "editorBracketPairGuide.background6": "#AAAAAA14"
  },
  "editor.overviewRulerLanes": 0,
  // "window.titleBarStyle": "custom",
  "workbench.layoutControl.enabled": false,
  "workbench.editor.labelFormat": "short",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.enableExperiments": false,
  "workbench.editor.enablePreview": false,
  "workbench.panel.defaultLocation": "right",
  "editor.minimap.enabled": false,
  "window.menuBarVisibility": "hidden",
  "explorer.decorations.badges": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.cursorBlinking": "expand",
  "editor.cursorStyle": "line",
  "editor.stickyScroll.enabled": false,
  "editor.colorDecorators": false,
  "editor.codeLens": false,
  "editor.links": false,
  "editor.matchBrackets": "never",
  "editor.parameterHints.enabled": false,
  "editor.hover.enabled": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.lineNumbers": "on",
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.showFoldingControls": "never",
  "editor.guides.indentation": false,
  "editor.renderWhitespace": "none",
  "editor.renderLineHighlight": "none",
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.quickSuggestions": {
    "other": "off"
  },
  "editor.suggestOnTriggerCharacters": false,
  "editor.snippetSuggestions": "top",
  "emmet.triggerExpansionOnTab": true,
  "files.autoSave": "off",
  "update.mode": "none",
  "symbols.hidesExplorerArrows": false,
  "breadcrumbs.enabled": false,
  "cSpell.enabled": false,
  "cSpell.language": "en,es",
  "#cSpell.enableFiletypes": [
    "!asciidoc",
    "!c",
    "!cpp",
    "!csharp",
    "!go",
    "!handlebars",
    "!haskell",
    "!jade",
    "!java",
    "!latex",
    "!php",
    "!pug",
    "!python",
    "!restructuredtext",
    "!rust",
    "!scala",
    "!scss"
  ],
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.renderSideBySide": true,
  "extensions.ignoreRecommendations": true,
  "explorer.fileNesting.enabled": true,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.patterns": {
    "package.json": ".eslint, prettier*, tsconfig*, vite*, pnpm-, bun.lockb, nest, package-lock*",
    "tailwind.config.": "tailwind.config, postcss.config*",
    ".env.local": ".env*",
    ".env": ".env*"
  },
  "editor.rulers": [
    //80,
    120
  ],
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.fontWeight": "500",
  "editor.linkedEditing": true,
  "editor.guides.bracketPairs": false,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.glyphMargin": true,
  "explorer.autoReveal": true,
  "editor.wordWrap": "on",
  "editor.fastScrollSensitivity": 5,
  "editor.smoothScrolling": true,
  "editor.scrollBeyondLastLine": false,
  "editor.renderControlCharacters": false,
  "editor.showUnused": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggestSelection": "first",
  "editor.tabCompletion": "onlySnippets",
  "editor.suggest.localityBonus": true,
  "editor.suggest.insertMode": "insert",
  "editor.lineHeight": 1.5,
  "editor.acceptSuggestionOnCommitCharacter": false,
  //"editor.scrollbar.verticalScrollbarSize": 10,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.stablePeek": false,
  "editor.renderLineHighlightOnlyWhenFocus": false,
  "editor.hover.delay": 0,
  "editor.semanticHighlighting.enabled": false,
  "editor.suggest.showStatusBar": true,
  "editor.lightbulb.enabled": "off",
  "editor.roundedSelection": true,
  "editor.multiCursorPaste": "spread",
  "editor.parameterHints.cycle": true,
  "editor.guides.highlightActiveIndentation": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.highlightActiveBracketPair": true,
  "editor.renderFinalNewline": "off",
  // "editor.snippetSuggestions":"inline",
  "editor.accessibilitySupport": "off",
  "editor.quickSuggestionsDelay": 10,
